{
  "contract_version": "1.3",
  "plugin_version": "0.5.0",
  "mcp_server": "company_knowledge_assistant",
  "candidate_contract": {
    "schema": "references/receipt-candidate-v1.schema.json",
    "source_of_truth": "packages/contracts/v1/submission-receipt-v1.schema.json#/$defs/ReceiptCandidateV1",
    "dereferenced": true
  },
  "current_task_business_status_contract": {
    "schema": "references/current-task-business-status-selection-v1.schema.json",
    "source_of_truth": "packages/contracts/v1/current-task-business-status-selection-v1.schema.json",
    "tool_argument": "current_task_business_status",
    "server_owned_fields": [
      "source_id",
      "source_system",
      "source_locator",
      "source_object_type",
      "source_access_basis",
      "source_revision",
      "immutable_locator",
      "evidence_manifest",
      "evidence_sha256",
      "knowledge_owner_upn"
    ]
  },
  "current_task_general_knowledge_contract": {
    "schema": "references/current-task-general-knowledge-selection-v1.schema.json",
    "source_of_truth": "packages/source_receipts/contracts/current-task-general-knowledge-selection-v1.schema.json",
    "tool_argument": "current_task_general_knowledge",
    "server_owned_fields": [
      "source_id",
      "source_system",
      "source_locator",
      "source_object_type",
      "source_access_basis",
      "source_revision",
      "immutable_locator",
      "evidence_manifest",
      "evidence_sha256",
      "knowledge_owner_upn"
    ]
  },
  "required_tools": [
    "get_profile",
    "prepare_knowledge_submission",
    "submit_knowledge_candidate",
    "get_publication_status"
  ],
  "explicit_invocation": {
    "accepted": [
      "@公司知识助手 with an explicit current-task check request",
      "a clear request to submit or publish explicitly selected evidence"
    ],
    "assessment_is_prepare_approval": false,
    "assessment_is_publish_confirmation": false,
    "bare_mention_is_sufficient": false,
    "exact_submission_request_authorizes_prepare": true,
    "exact_candidate_selection_authorizes_prepare": true
  },
  "default_candidate_limit": 3,
  "one_receipt_type_per_candidate": true,
  "process_candidates_sequentially": true,
  "decision_outcomes": [
    "PREPARE_NOW",
    "PREPARE_BEFORE_TASK_END",
    "CORRECTION_REQUIRED",
    "NEED_MORE_EVIDENCE",
    "SENSITIVE_OR_RESTRICTED",
    "NO_SUBMIT"
  ],
  "common_gates": [
    "material_change",
    "reusable_or_cross_role_value",
    "evidence_complete",
    "company_public_internal",
    "employee_selected_candidate"
  ],
  "evidence_scope": {
    "allowed": "current_task_plus_employee_explicit_selection_only",
    "full_conversation_default": false,
    "arbitrary_workspace_scan": false,
    "third_party_oauth_required": false,
    "background_collection": false
  },
  "prepare": {
    "tool": "prepare_knowledge_submission",
    "remote_effect": "employee_owned_ephemeral_preview",
    "preview_ttl_minutes": 30,
    "authorization": "explicit_exact_submission_request_or_exact_candidate_selection",
    "separate_confirmation_after_exact_intent_required": false,
    "maximum_calls_per_exact_intent": 1,
    "creates_published_knowledge": false,
    "cancel": "do_not_submit_and_allow_preview_to_expire"
  },
  "submit": {
    "tool": "submit_knowledge_candidate",
    "single_final_confirmation_required": true,
    "formal_confirmation_count_after_exact_intent": 1,
    "accepted_fields": [
      "preview_id",
      "preview_payload_sha256",
      "user_confirmed"
    ],
    "confirmation_binding": {
      "client_request_id": "server_resolves_from_authenticated_owned_preview; optional_0_4_7_value_is_ignored_for_backward_compatibility",
      "preview_id": "copy_exactly_from_preview.preview_id",
      "preview_payload_sha256": "copy_exactly_from_preview.preview_payload_sha256",
      "user_confirmed": "true_after_single_final_exact_confirmation",
      "fresh_client_request_id_forbidden": true,
      "model_copies_client_request_id": false
    },
    "candidate_payload_accepted": false,
    "maximum_calls_per_confirmation": 1,
    "effect": "direct_published_knowledge_plus_immutable_receipt",
    "human_review_queue": false
  },
  "status": {
    "tool": "get_publication_status",
    "read_only": true,
    "maximum_checks": 3,
    "maximum_elapsed_seconds": 60,
    "index_pending_is_visible": false
  },
  "retry_policy": {
    "prepare_automatic_retries": 0,
    "submit_automatic_retries": 0,
    "unknown_submit_outcome": "preserve_operation_id_and_check_status_never_blind_retry",
    "changed_preview": "obtain_new_exact_selection_and_prepare_again"
  },
  "correction": {
    "inherits_original_receipt_type": true,
    "required_fields": [
      "previous_receipt_id",
      "supersedes_knowledge_id",
      "correction_reason"
    ],
    "history_preserved": true,
    "delete_or_overwrite": false
  },
  "completion_states": [
    "no_submit",
    "needs_more_evidence",
    "sensitive_or_restricted",
    "preview_cancelled",
    "preview_expired",
    "published_visible",
    "published_index_pending",
    "publication_recovery_required"
  ],
  "state_transitions": [
    "idle->assessed",
    "idle->exact_submission_intent",
    "assessed->candidate_selected",
    "exact_submission_intent->preview_ready",
    "candidate_selected->preview_ready",
    "preview_ready->preview_cancelled",
    "preview_ready->submit_confirmed",
    "submit_confirmed->published_visible",
    "submit_confirmed->published_index_pending",
    "submit_confirmed->publication_recovery_required"
  ]
}
